# Public Firebase Web App config values. These are client identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Canonical FastAPI origin. Use an HTTPS origin outside local development.
NEXT_PUBLIC_ECOLOOP_API_ORIGIN=
