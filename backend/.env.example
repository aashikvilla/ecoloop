# Existing API settings
PORT=8000
FIREBASE_PROJECT_ID="ecoloop-staging-20261015"
BACKEND_CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]

# Set GEMINI_API_KEY (preferred) or GOOGLE_API_KEY for Gemini Developer API;
# GEMINI_API_KEY wins if both are set. Or select vertex and set
# AGENT_VERTEX_PROJECT_ID for Vertex AI with Application Default Credentials.
# With auto, a Developer API key wins; otherwise a configured Vertex project
# selects Vertex. No key or project means the assistant is unavailable.
AGENT_PROVIDER=auto
GEMINI_API_KEY=
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.1-flash-lite
AGENT_VERTEX_PROJECT_ID=
AGENT_VERTEX_LOCATION=us-central1
AGENT_REQUEST_TIMEOUT_SECONDS=20
AGENT_MAX_OUTPUT_TOKENS=4096
