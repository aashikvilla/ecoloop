digraph permissions_and_ownership {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Permissions And Ownership" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	PERS [label="Personal account
private history" color="#173e32" fillcolor="#173e32" fontcolor=white]
	FAM [label="Family kitchen
shared, permissioned" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	OD [label="Order history
private by default" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	STOCK [label="Confirmed shared
stock and plans" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	MEM [label="Personal Memory Bank
explicit opt-in" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	OFF [label="Offer to household
scoped visibility" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	REAL [label="External actor action
requires consent" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	PERS -> FAM [label="join/create"]
	PERS -> OD
	PERS -> MEM
	FAM -> STOCK
	FAM -> OFF
	OFF -> REAL [label="explicit approval"]
}
