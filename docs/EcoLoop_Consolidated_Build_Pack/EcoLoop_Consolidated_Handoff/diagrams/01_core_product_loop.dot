digraph core_product_loop {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Core Product Loop" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	CAP [label="Capture or import
food evidence" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	TRUTH [label="Confirm available
kitchen facts" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	ASK [label="Ask EcoLoop
photo / text / voice" color="#173e32" fillcolor="#173e32" fontcolor=white]
	ACTION [label="Cook, compare or
share in time" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	LOG [label="Record actual
outcome" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	PROG [label="Show sourced
progress" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	ORG [label="Genuine scraps →
appropriate handling" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	CAP -> TRUTH
	TRUTH -> ASK
	ASK -> ACTION
	ACTION -> LOG
	LOG -> PROG
	ACTION -> ORG [label="not usable as food"]
	ORG -> LOG
	PROG -> TRUTH [label="new observations" style=dashed]
}
