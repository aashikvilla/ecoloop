digraph multimodal_capture_and_commit {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Multimodal Capture And Commit" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	PHOTO [label="Camera / receipt /
written list / manual" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	EX [label="Gemini produces
CANDIDATE items" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	REV [label="Review names, units,
quantity, date source" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	DUP [label="Check existing
stock / duplicate" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	DEC [label="Replace / Add /
Separate / Skip" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	AUTH [label="Authenticated user
approves" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	DB [label="Firestore versioned
confirmed facts" color="#173e32" fillcolor="#173e32" fontcolor=white]
	REJ [label="Uncertain → needs
check; do not infer" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	PHOTO -> EX
	EX -> REV
	REV -> DUP
	REV -> REJ [label=uncertainty]
	DUP -> DEC
	DEC -> AUTH
	AUTH -> DB
}
