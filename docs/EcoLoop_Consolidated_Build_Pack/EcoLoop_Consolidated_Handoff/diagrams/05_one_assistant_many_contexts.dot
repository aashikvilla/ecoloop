digraph one_assistant_many_contexts {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="One Assistant Many Contexts" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	HOME [label="Home → cook
suggestion" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	KITCH [label="Kitchen → selected
food context" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	SHOP [label="Shop → product
photo or list" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	LEFT [label="Use-soon →
leftover context" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	AG [label="ONE EcoLoop Assistant
current session" color="#173e32" fillcolor="#173e32" fontcolor=white]
	CARD [label="Typed UI card:
recipe / comparison / action" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	AP [label="User edits and
approves" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	TOOL [label="FastAPI trusted tool
updates state" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	HOME -> AG
	KITCH -> AG
	SHOP -> AG
	LEFT -> AG
	AG -> CARD
	CARD -> AP
	AP -> TOOL
}
