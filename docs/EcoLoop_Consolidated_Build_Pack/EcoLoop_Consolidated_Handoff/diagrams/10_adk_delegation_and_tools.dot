digraph adk_delegation_and_tools {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Adk Delegation And Tools" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	ROOT [label="Coordinator agent
intent + context" color="#173e32" fillcolor="#173e32" fontcolor=white]
	KIT [label="Kitchen agent
recipes, substitutions" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	SHOP [label="Shopping agent
compare packs, draft list" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	REC [label="Food Action tools
use, share, disposal" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	M [label="Memory Bank + Sessions
only scoped context" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	DB [label="Firestore facts
queried via tools" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	GUARD [label="FastAPI validators
permissions and math" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	UI [label="Structured typed
interactive response" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	ROOT -> KIT
	ROOT -> SHOP
	ROOT -> REC [label="tools first"]
	KIT -> GUARD
	SHOP -> GUARD
	REC -> GUARD
	ROOT -> M
	ROOT -> DB
	GUARD -> UI
}
