digraph screen_navigation {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Screen Navigation" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	LOGIN [label="Welcome / Login" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	MODE [label="Solo / Create /
Join family" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	HOME [label="HOME
Priorities + impact" color="#173e32" fillcolor="#173e32" fontcolor=white]
	KITCH [label="KITCHEN
Items + reminders" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	ASK [label="ASK
Contextual GenUI" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	SHOP [label="SHOP
List + comparison" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	CAP [label="Add Food
Photo / receipt / list" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	REV [label="Review and confirm" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	ACT [label="Use soon / share /
compost or dispose" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	PROG [label="Progress + evidence" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	SETS [label="Settings / Connections
/ Memory privacy" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	LOGIN -> MODE
	MODE -> HOME
	HOME -> KITCH
	HOME -> ASK
	HOME -> SHOP
	KITCH -> CAP
	CAP -> REV
	REV -> KITCH
	KITCH -> ACT
	ACT -> ASK
	ACT -> PROG
	HOME -> PROG
	HOME -> SETS
	SHOP -> ASK
}
