digraph shopping_decision {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Shopping Decision" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	IMAGE [label="Product photo /
shopping item" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	PARSE [label="Gemini candidate
product + pack size" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	CHECK [label="Confirm scanned
product details" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	STOCK [label="Check last-confirmed
stock + selected recipe" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	CHOICE [label="Have enough?
Need / uncertain" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	NO [label="Use current stock /
check again" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	LIST [label="Update shopping
list with approval" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	MCP [label="Merchant catalog /
MCP (only authorized)" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	CART [label="Cart PREVIEW; human
review, no auto-charge" color="#173e32" fillcolor="#173e32" fontcolor=white]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	IMAGE -> PARSE
	PARSE -> CHECK
	CHECK -> STOCK
	STOCK -> CHOICE
	CHOICE -> NO [label=enough]
	CHOICE -> LIST [label=missing]
	LIST -> MCP [label=optional]
	MCP -> CART
}
