digraph google_cloud_runtime_architecture {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Google Cloud Runtime Architecture" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	WEB [label="Next.js / TypeScript
Firebase App Hosting" color="#173e32" fillcolor="#173e32" fontcolor=white]
	AUTH [label="Firebase Auth +
role/tenant checks" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	API [label="FastAPI on Cloud Run
policy + approvals" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	AG [label="Agent Platform Runtime
Google ADK + Gemini" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	MEM [label="Memory Bank: opt-in
preferences" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	SESSION [label="Managed Sessions
short-term context" color="#c7d7cc" fillcolor="#eee9f7" fontcolor="#173e32"]
	FACT [label="Firestore: confirmed
kitchen events" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	PHOTO [label="Cloud Storage:
consented media" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	UI [label="Trusted React cards
optional A2UI" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	MCP [label="Merchant MCP adapter
DISABLED until authorized" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	TRACE [label="Cloud Logging / Trace
Agent evaluation" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	BQ [label="BigQuery metrics
actual observations" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	WEB -> AUTH
	AUTH -> API
	API -> AG
	AG -> MEM
	AG -> SESSION
	AG -> FACT
	API -> PHOTO
	AG -> UI
	UI -> WEB
	API -> MCP [label=conditional]
	API -> TRACE
	API -> BQ
}
