digraph onboarding_and_consent {
	graph [bgcolor=white dpi=160 fontcolor="#173e32" fontname="DejaVu Sans" fontsize=14 label="Onboarding And Consent" labelloc=t nodesep=0.25 pad=0.27 rankdir=LR ranksep=0.45 splines=spline]
	node [color="#c7d7cc" fillcolor="#f3fbf6" fontcolor="#173e32" fontname="DejaVu Sans" fontsize=11 margin="0.17,0.13" penwidth=1.05 shape=box style="rounded,filled"]
	W [label="Welcome
Try demo / Sign in" color="#173e32" fillcolor="#173e32" fontcolor=white]
	S [label="Firebase Auth
Google / email" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	H [label="Select kitchen mode" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	SO [label="Solo
no invitations" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	CR [label="Create family
invite optional" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	JO [label="Join by invitation
requires approval" color="#c7d7cc" fillcolor="#dff2e6" fontcolor="#173e32"]
	PREF [label="Optional preferences
consent to remember" color="#c7d7cc" fillcolor="#fff0d8" fontcolor="#173e32"]
	ADD [label="Add a few items
or skip" color="#c7d7cc" fillcolor="#e8f0f6" fontcolor="#173e32"]
	FIRST [label="First useful action
cook / check / buy" color="#173e32" fillcolor="#173e32" fontcolor=white]
	edge [arrowsize=0.72 color="#557164" fontcolor="#aa5a2c" fontname="DejaVu Sans" fontsize=9 penwidth=1.15]
	W -> S
	S -> H
	H -> SO [label=solo]
	H -> CR [label=create]
	H -> JO [label=join]
	SO -> PREF
	CR -> PREF
	JO -> PREF
	PREF -> ADD
	ADD -> FIRST
}
